# Copy to .env.local. Read by sanity.cli.ts / sanity.config.ts.
SANITY_STUDIO_PROJECT_ID=jok2puek
# The Studio has two workspaces, /production and /development, one per dataset.
# The CLI (typegen, seed) defaults to this dataset; --dataset overrides it.
SANITY_STUDIO_DATASET=development
# Where each workspace's Presentation tool previews (draft mode: /api/draft-mode/enable)
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
SANITY_STUDIO_PREVIEW_URL_PRODUCTION=https://www.damilolabada.com
